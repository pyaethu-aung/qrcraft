{
  "name": "qrcraft",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "npm run build --workspace=packages/core && npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/core && npm run build --workspace=apps/web && npm run build --workspace=apps/mcp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run build --workspace=packages/core && vitest",
    "test:watch": "npm run build --workspace=packages/core && vitest watch",
    "test:coverage": "npm run build --workspace=packages/core && npm run test:coverage --workspace=packages/core && npm run test:coverage --workspace=apps/web",
    "test:e2e": "npm run build --workspace=packages/core && npm run test:e2e --workspace=apps/web",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "preview": "npm run preview --workspace=apps/web",
    "docker:build": "docker build -t qrcraft:local .",
    "docker:run": "docker run --rm -p 8080:80 --name qrcraft --read-only --cap-drop ALL --tmpfs /var/cache/nginx:mode=1777 --tmpfs /tmp:mode=1777 qrcraft:local"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.20",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.16",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "react-helmet-async": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
