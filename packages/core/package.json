{
  "name": "@qrcraft/core",
  "private": true,
  "version": "0.1.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils/qrDecode": {
      "types": "./dist/utils/qrDecode.d.ts",
      "default": "./dist/utils/qrDecode.js"
    },
    "./i18n/*.json": "./src/i18n/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "qrcode": "^1.5.4"
  }
}
